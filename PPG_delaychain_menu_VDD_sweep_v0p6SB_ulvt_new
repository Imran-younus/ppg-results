#!/bin/ksh
#=============================================================================
# PPG_delaychain_menu_VDD_sweep_v0p6SB_ulvt_new
# Purpose : Run HSPICE 14-point VDD sweep (336 jobs) for 24 cells with ULVT.
#=============================================================================

SCRIPTDIR=$(cd "$(dirname "$0")" && pwd)

export VT="${VT:-ulvt}"
export VDD="${VDD:-sweep}"
export TEMP="${TEMP:-25}"
export OUTPUT="${OUTPUT:-$SCRIPTDIR/PPGRO_chain_menu14.txt}"

exec "$SCRIPTDIR/run_ppg_sim.sh" "$@"
