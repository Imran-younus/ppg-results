#!/bin/ksh
#=============================================================================
# PPG_delaychain_menu_sweep_v0p6SB_ulvt_new
# Purpose : Run HSPICE single-stage delay-chain simulations for 24 cell types
#           at a single VDD point (default 0.70V or user-specified VDD).
#=============================================================================

SCRIPTDIR=$(cd "$(dirname "$0")" && pwd)

export VT="${VT:-ulvt}"
export VDD="${VDD:-0.70}"
export TEMP="${TEMP:-25}"
export OUTPUT="${OUTPUT:-$SCRIPTDIR/PPGRO_chain_menu.txt}"

exec "$SCRIPTDIR/run_ppg_sim.sh" "$@"
